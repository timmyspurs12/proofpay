# --- ProofPay environment (copy to .env, never commit real secrets) ---
# Local demo database (SQLite). For PostgreSQL see docs/DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# Session signing secret for the demo persona session cookie (set a long random value in production)
SESSION_SECRET="[SECURITY_DATA]"

# --- GenLayer (optional; without these the app runs clearly-labelled Demo Adjudication) ---
# Network: studionet | testnetBradbury | localnet  (see docs.genlayer.com/developers/networks)
GENLAYER_NETWORK="studionet"
# Deployed ProofPayAdjudicator address (deploy contracts/proofpay_adjudicator.py first — see docs/GENLAYER.md)
GENLAYER_CONTRACT_ADDRESS=""
# Server-side signer for adjudication writes. TESTNET ONLY. Never expose to the browser.
GENLAYER_PRIVATE_KEY=""

# Base URL (used for links/receipts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
